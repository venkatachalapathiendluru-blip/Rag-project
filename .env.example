# Required
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
NVIDIA_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
DB_PASSWORD=

# Database (defaults shown)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=rag_db
# DB_USER=rag_user
# RAG_DB_POOL_SIZE=8

# Security. Set a long random token before exposing the API beyond this machine.
# RAG_API_TOKEN=
# RAG_CORS_ORIGINS=http://localhost:5173
# RAG_REDACT_OUTPUT=phone,email
# RAG_RATE_LIMIT_REQUESTS=10
# RAG_UPLOAD_RATE_LIMIT_REQUESTS=10
# RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Retrieval and limits
# RAG_RETRIEVAL_PROFILE=rrf3_1_top10
# RAG_RRF_VECTOR_WEIGHT=3.0
# RAG_RRF_KEYWORD_WEIGHT=1.0
# RAG_RERANK_TIMEOUT_SECONDS=120
# RAG_RERANK_MAX_RETRIES=2
# RAG_MAX_UPLOAD_MB=20
# RAG_MAX_PDF_PAGES=500

# Paths
# RAG_UPLOAD_DIR=uploads
# RAG_TRACE_DIR=traces
# RAG_REPORTS_DIR=.

# Schema changes are an explicit step: python -m backend.migrate
# Set to true only if you want the API to apply them at startup.
RAG_AUTO_MIGRATE=false
